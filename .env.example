# Copy to .env (start.bat does this on first run). Restart after changes.

# 127.0.0.1 = this PC only. 0.0.0.0 = also reachable from devices on your Wi-Fi (iPhone).
# Never port-forward this to the internet: the app has no login.
PT_HOST=127.0.0.1
PT_PORT=8000

# Data folder (database + backups). Default: ./data
# PT_DATA_DIR=C:\Users\you\Documents\PortfolioTracker

# ---- Price sources (all optional; keys stay on this PC, never sent to the browser) ----
# Longbridge OpenAPI: US, HK, SG quotes. Needs a Longbridge account; create the
# app key/secret/access token in the Longbridge developer centre (open.longbridge.com).
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Alpaca market data: US stocks/ETFs. Free account (paper is fine) -> API keys in the dashboard.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free real-time feed (IEX exchange only). sip = all US exchanges (paid plan).
ALPACA_DATA_FEED=iex

# Optional free Alpha Vantage key for US stock prices (https://www.alphavantage.co/support/#api-key).
# Stays on the server, never sent to the browser.
ALPHAVANTAGE_API_KEY=

# 1 = background price/FX refresh on a schedule (interval set in the app's Settings).
PT_SCHEDULER=1

# ---- AI (optional): statement PDF reading and "Ask about my portfolio" ----
# Your holdings (symbols, amounts, brokers) are sent to the provider when you use these features.
# Free tiers may use what you send to improve their models.
# Google Gemini (reads PDFs directly, incl. scanned ones). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Groq (fast, used first for questions). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Any other OpenAI-compatible endpoint (OpenRouter, a local Ollama at http://localhost:11434/v1, ...)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
